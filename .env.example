NODE_ENV=development
NILAM_DOMAIN=localhost
POSTGRES_DB=nilam
POSTGRES_USER=nilam
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://nilam:change-me@postgres:5432/nilam
MEILI_MASTER_KEY=change-this-to-at-least-16-characters
MEILI_HOST=http://meilisearch:7700
NEXT_PUBLIC_SITE_URL=https://localhost
# rich = current NilamApp shell; safe = verified engine-backed matcher fallback.
NILAM_HOME_MODE=rich
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_FROM=NILAM <no-reply@localhost>
# Optional outside production; local magic links are logged as JSON.
# AUTH_SMTP_URL=smtp://user:password@mail.example.com:587
TELEGRAM_BOT_USERNAME=NilamLocalBot
TELEGRAM_LINK_SECRET=replace-with-a-long-random-bot-link-secret
# Optional outside production; local Telegram deliveries are logged as JSON.
# TELEGRAM_BOT_TOKEN=
# ALERT_SMTP_URL=
ALERT_EMAIL_FROM=NILAM <alerts@localhost>
WORKER_CONCURRENCY=2
LOG_LEVEL=info
UMAMI_APP_SECRET=change-this-to-a-long-random-value
# Production defaults to disabled. Use fake only on local/CI.
PAYMENT_GATEWAY_MODE=fake
FAKE_PAYMENT_SECRET=nilam-safe-fake-payment-secret
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_STORAGE_DIR=.data/documents
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm
LOG_LEVEL=info
# Never set E2E_AUTH_SECRET in production. It unlocks /api/e2e/session.
# E2E_AUTH_SECRET=
# Live Razorpay is locked until RAZORPAY_ALLOW_LIVE=true in an approved environment.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PRO_PLAN_ID=
# RAZORPAY_CONSULTANT_PLAN_ID=
# RAZORPAY_ALLOW_LIVE=false
